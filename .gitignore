# MicroPython build artifacts
__pycache__/
*.pyc
*.mpy

# Credentials (WiFi passwords on ESP32)
wifi.json
# OTA Basic-Auth secret. ota_auth.py (below) was ignored but its Arduino-side
# twin was not: firmware/arduino/.env holds OTA_AUTH_B64 in clear text and sat
# untracked-but-unignored for months. `git add -A` is called safe inside the
# project repos, and that is exactly what would have committed it.
.env

# Agent worktrees
.worktrees/
.git-main/

# IDE / tools
.mypy_cache/
.venv/
.platformio/
.playwright-mcp/
result.json
enclosure/result.json
enclosure/bambu-profiles/result.json

# Manifest state — no longer produced. The hashes now live in manifest.json
# itself; keeping them in a gitignored side file made version bumps depend on
# untracked local state, so a fresh clone bumped every game with unchanged
# content. Entry kept so old working copies do not re-add the stale file.
.manifest-state.json

# Temp files
*.tmp

# Pre-compressed game files (generated by tools/minify_gzip.py)
games/*.gz

# Printer credentials
enclosure/bambu-profiles/printer.env

# OTA authentication (contains credentials)
ota_auth.py

# Project agent config (not for public)
PROJECT.md
CLAUDE.md
TASKS.md
project.toml
pyproject.toml
uv.lock

# Brainstorm sessions
.superpowers/

# Playwright
tests/e2e/node_modules/
tests/e2e/test-results/

# Downloaded firmware binary (re-downloaded on demand)
tools/.micropython-firmware.bin
docs/plans/
docs/specs/
